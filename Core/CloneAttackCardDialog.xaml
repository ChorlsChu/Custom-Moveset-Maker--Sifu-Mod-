<Window x:Class="SifuMovesetEditor.CloneAttackCardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clone Attack Card"
        Width="580" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b4d0fb"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="Foreground" Value="#6c7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8" Margin="-16,-16,-16,12">
            <TextBlock Text="Clone Attack Card" FontWeight="Bold"
                       Foreground="#89b4fa" FontSize="15"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancel" Style="{StaticResource DarkButton}"
                    Content="Cancel" Click="Cancel_Click" Padding="16,8"
                    MinHeight="30" MinWidth="80" IsCancel="True"/>
            <Button x:Name="btnClone" Style="{StaticResource AccentButton}"
                    Content="Clone" Click="Clone_Click" Padding="16,8"
                    MinHeight="30" MinWidth="90" IsDefault="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#a6adc8" FontSize="11" LineHeight="16"
                       Margin="0,0,0,10">
                <Run Text="Copies "/><Run x:Name="runSource" FontWeight="SemiBold" Foreground="#cdd6f4"/>
                <Run Text=" into your Custom Moves library. Vanilla files are never modified; the copy ships with your export."/>
            </TextBlock>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Attack Card name" VerticalAlignment="Center"
                           Foreground="#cdd6f4" FontSize="12"/>
                <TextBox x:Name="txtName" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                         MaxLength="48" TextChanged="Name_TextChanged"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <CheckBox x:Name="chkCloneHit" IsChecked="True"
                          Foreground="#cdd6f4" FontSize="12"
                          Content="Clone hit window"
                          Checked="CloneHit_Changed" Unchecked="CloneHit_Changed"
                          VerticalAlignment="Center"/>
                <Button x:Name="btnHitHelp" Content="?" Click="HitHelp_Click"
                        Style="{StaticResource DarkButton}" Padding="6,1" FontSize="11"
                        Margin="8,0,0,0" Cursor="Help" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="txtHitHelp" TextWrapping="Wrap" Foreground="#a6adc8"
                       FontSize="11" LineHeight="16" Margin="26,4,0,0"
                       Text="Copies this card's hit data row so your clone gets a PRIVATE copy - edits to parriable / damage / stun on the clone never affect other attacks. Recommended if you plan to touch hit stats. Unchecked = the clone keeps pointing at the shared vanilla row (edits there may leak to every attack using it); you can still give it a private row later from the Hit Windows dialog."/>

            <Border Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                <TextBlock x:Name="txtPreview" Foreground="#a6adc8" FontSize="11"
                           FontFamily="Consolas" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="txtError" Foreground="#f38ba8" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
