<Window x:Class="SifuMovesetEditor.NewMovesetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sifu Moveset Editor"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1e1e2e"/>
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#cdd6f4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8" Margin="-16,-16,-16,12">
            <TextBlock Text="New Custom Moveset" FontWeight="Bold"
                       Foreground="#89b4fa" FontSize="15"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancel" Style="{StaticResource DarkButton}"
                    Content="Cancel" Click="Cancel_Click" Padding="16,8"
                    MinHeight="30" MinWidth="80" IsCancel="True"/>
            <Button x:Name="btnCreate" Style="{StaticResource AccentButton}"
                    Content="Create" Click="Create_Click" Padding="16,8"
                    MinHeight="30" MinWidth="90" IsDefault="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock Text="Builds a new combo file from scratch. Vanilla combo files are never modified - the selected ArchetypeDBs get a copy that points at your new file at export time."
                       TextWrapping="Wrap" Foreground="#a6adc8" FontSize="11" LineHeight="16"
                       Margin="0,0,0,10"/>

            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Moveset name" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="12"/>
                <TextBox x:Name="txtName" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                         MaxLength="48" TextChanged="Name_TextChanged"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Donor combo" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="12"/>
                <ComboBox x:Name="cmbDonor" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                          SelectionChanged="Donor_SelectionChanged"/>
            </Grid>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Repoint targets" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="12"/>
                <StackPanel Grid.Column="1">
                    <TextBlock x:Name="txtScanStatus" Text="Pick a donor to scan for referencing ArchetypeDBs."
                               Foreground="#a6adc8" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <Border Background="#181825" CornerRadius="4" Padding="8,6" MaxHeight="170">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="panelTargets"/>
                        </ScrollViewer>
                    </Border>
                    <CheckBox x:Name="chkWeapons" IsChecked="True" Margin="0,6,0,0"
                              Foreground="#cdd6f4" FontSize="12"
                              Content="Also patch weapon combo pointers (m_ComboOverride)"/>
                </StackPanel>
            </Grid>

            <Border Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,10,0,0">
                <TextBlock x:Name="txtPreview" Foreground="#a6adc8" FontSize="11"
                           FontFamily="Consolas" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="txtError" Foreground="#f38ba8" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
