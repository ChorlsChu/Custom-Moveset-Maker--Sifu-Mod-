<UserControl x:Class="SifuMovesetEditor.TutorialOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" IsHitTestVisible="True"
             Focusable="True" KeyboardNavigation.TabNavigation="Cycle">

    <UserControl.Resources>
        <Style x:Key="TutPrimary" TargetType="Button">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74a8f7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TutGhost" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#cdd6f4"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="host" ClipToBounds="True">
        <!-- Dimming layer. The target rectangle is excluded from the geometry, and a Path
             only hit-tests its filled area, so everything inside the spotlight stays clickable. -->
        <Path x:Name="dimPath" Fill="#C2101018" IsHitTestVisible="True"
              MouseLeftButtonDown="DimPath_Click"/>

        <Canvas x:Name="markerLayer" IsHitTestVisible="False">
            <Border x:Name="ringGlow" BorderBrush="#4489b4fa" BorderThickness="7"
                    CornerRadius="10" Visibility="Collapsed"/>
            <Border x:Name="ring" BorderBrush="#89b4fa" BorderThickness="2"
                    CornerRadius="8" Visibility="Collapsed"/>
        </Canvas>

        <Canvas x:Name="bubbleLayer">
            <Border x:Name="bubble" Width="366" Visibility="Collapsed"
                    Background="#1e1e2e" BorderBrush="#89b4fa" BorderThickness="1"
                    CornerRadius="8" Padding="18,14,18,14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.5" Color="#000000"/>
                </Border.Effect>
                <StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button x:Name="btnExit" DockPanel.Dock="Right" Content="✕"
                                Style="{StaticResource TutGhost}" Padding="7,2" FontSize="12"
                                ToolTip="Exit the walkthrough (Esc)"
                                Click="Exit_Click"/>
                        <TextBlock x:Name="txtStep" Text="" FontSize="10" FontWeight="Bold"
                                   Foreground="#89b4fa" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ProgressBar x:Name="stepBar" Height="2" Margin="0,7,0,12"
                                 Minimum="0" Maximum="1" Value="0"
                                 Foreground="#89b4fa" Background="#313244" BorderThickness="0"/>

                    <TextBlock x:Name="txtTitle" Text="" FontSize="17" FontWeight="Bold"
                               Foreground="#89b4fa" TextWrapping="Wrap"
                               Margin="0,0,0,7"/>

                    <TextBlock x:Name="txtBody" Text="" FontSize="12.5" Foreground="#cdd6f4"
                               TextWrapping="Wrap" LineHeight="19"/>

                    <Border x:Name="hintBox" Visibility="Collapsed" Background="#181825"
                            BorderBrush="#f9e2af" BorderThickness="3,0,0,0"
                            CornerRadius="0,4,4,0" Padding="10,7,12,7" Margin="0,11,0,0">
                        <TextBlock x:Name="txtHint" Text="" FontSize="11.5" Foreground="#f9e2af"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <Border x:Name="nudgeBox" Visibility="Collapsed" Background="#2a1e1e"
                            BorderBrush="#f38ba8" BorderThickness="3,0,0,0"
                            CornerRadius="0,4,4,0" Padding="10,7,12,7" Margin="0,11,0,0">
                        <TextBlock x:Name="txtNudge" Text="" FontSize="11.5" Foreground="#f38ba8"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="txtWaiting" Visibility="Collapsed"
                               Text="Waiting for you — this step finishes when you do it"
                               FontSize="11" Foreground="#89b4fa" TextWrapping="Wrap"
                               Margin="0,11,0,0"/>

                    <DockPanel Margin="0,14,0,0" LastChildFill="False">
                        <Button x:Name="btnNext" DockPanel.Dock="Right" Content="Next"
                                Style="{StaticResource TutPrimary}" Click="Next_Click"/>
                        <Button x:Name="btnBack" DockPanel.Dock="Left" Content="Back"
                                Style="{StaticResource TutGhost}" Click="Back_Click"
                                Margin="-10,0,0,0"/>
                        <TextBlock x:Name="txtCounter" Text="" FontSize="10.5"
                                   Foreground="#6c7086" VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
