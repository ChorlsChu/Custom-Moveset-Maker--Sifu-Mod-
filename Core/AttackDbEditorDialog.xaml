<Window x:Class="SifuMovesetEditor.AttackDbEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hit Windows"
        Width="720" Height="640" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e2e" Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74a8f7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#11111b"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="CaretBrush" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DarkCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1e1e2e"/>
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="6,3">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#cdd6f4"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#cdd6f4"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Hit Windows" FontSize="15" FontWeight="Bold"
                           Foreground="#89b4fa" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtSubtitle" Text="" Foreground="#6c7086" FontSize="12"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource DarkButton}" Click="Cancel_Click"
                            Padding="14,5" IsCancel="True"/>
                    <Button Content="OK" Style="{StaticResource AccentButton}" Click="Ok_Click"
                            Padding="18,5" IsDefault="True"/>
                </StackPanel>
                <TextBlock x:Name="txtStatus" Text="" Foreground="#6c7086" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtNote" FontSize="11" Foreground="#a6adc8"
                       TextWrapping="Wrap"
                       Text="Edits apply to this attack card on export and sync to every node that uses the same card. Leave a field empty to keep its vanilla value."/>

            <Border Grid.Row="2" Background="#181825" CornerRadius="4"
                    BorderBrush="#313244" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel x:Name="windowsPanel"/>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Row="3" x:Name="txtSharedWarning" FontSize="11" Foreground="#f9e2af"
                       TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>

    <!-- Field help overlay (same pattern as the Unit Props "?" popups). -->
    <Border Name="infoPopup" Visibility="Collapsed" Background="#99000000"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="101"
            MouseLeftButtonDown="InfoPopup_Click">
        <Border Background="#1e1e2e" CornerRadius="6" BorderBrush="#89b4fa" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="14" Width="340">
            <StackPanel>
                <TextBlock Name="infoTitle" Text="" Foreground="#89b4fa"
                           FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Name="infoDesc" Text="" Foreground="#cdd6f4"
                           FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
