<Window x:Class="SifuMovesetEditor.BranchChancesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conditions &amp; Chances"
        Width="900" Height="660" MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e2e" Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74a8f7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#11111b"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="CaretBrush" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Conditions &amp; Chances" FontSize="15" FontWeight="Bold"
                           Foreground="#89b4fa" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtSubtitle" Text="" Foreground="#6c7086" FontSize="13"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="12,6">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Style="{StaticResource DarkButton}" Click="Cancel_Click"
                            Padding="14,5" IsCancel="True"/>
                    <Button Content="OK" Style="{StaticResource AccentButton}" Click="Ok_Click"
                            Padding="18,5" IsDefault="True"/>
                </StackPanel>
                <TextBlock x:Name="txtStatus" Text="" Foreground="#6c7086" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <Grid Margin="16,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtNote" FontSize="11" Foreground="#a6adc8"
                       TextWrapping="Wrap"
                       Text="Each row is one transition of this node's combo struct: when the move plays, the engine picks a row by cumulative probability (vanilla rows always sum to 100%). New links join the split automatically - export rebalances the set so the appended rows stay reachable. Typed values are kept exactly; automatic rows share the remainder. Condition parameters and outcome routing are editable below (enemy trees); required tags and conditional attacks stay view-only for now."/>

            <Border Grid.Row="2" Background="#181825" CornerRadius="4"
                    BorderBrush="#313244" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,8">
                    <StackPanel x:Name="rowsPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
