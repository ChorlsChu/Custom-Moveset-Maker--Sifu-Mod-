<Window x:Class="SifuMovesetEditor.BugReportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a Bug"
        Width="700" Height="720" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="#1e1e2e" Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="CaretBrush" Value="#cdd6f4"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#6c7086"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,14,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="18,12">
            <StackPanel>
                <TextBlock Text="Report a Bug" FontSize="17" FontWeight="Bold" Foreground="#89b4fa"/>
                <TextBlock Text="Goes straight to the author's private inbox. No account needed."
                           FontSize="11" Foreground="#6c7086" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="18,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="btnSend" Content="Send" Style="{StaticResource AccentButton}"
                            Click="Send_Click"/>
                    <Button x:Name="btnCopy" Content="Copy report" Style="{StaticResource DarkButton}"
                            Click="Copy_Click"/>
                    <Button x:Name="btnSaveZip" Content="Save .zip…" Style="{StaticResource DarkButton}"
                            Click="SaveZip_Click"/>
                    <Button Content="Cancel" Style="{StaticResource DarkButton}"
                            IsCancel="True" Click="Cancel_Click"/>
                </StackPanel>
                <TextBlock x:Name="txtResult" Text="" FontSize="11" Foreground="#6c7086"
                           VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0"/>
            </DockPanel>
        </Border>

        <!-- Body -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,14">
            <StackPanel>
                <TextBlock Text="Summary" Style="{StaticResource Label}"/>
                <TextBox x:Name="txtTitle" Style="{StaticResource FieldBox}" MaxLength="120"
                         Margin="0,0,0,12"/>

                <TextBlock Text="Type" Style="{StaticResource Label}"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="rbBug" Content="Bug" IsChecked="True"/>
                    <RadioButton x:Name="rbCrash" Content="Crash / freeze"/>
                    <RadioButton x:Name="rbFeature" Content="Feature request"/>
                </StackPanel>

                <TextBlock Text="What happened?" Style="{StaticResource Label}"/>
                <TextBox x:Name="txtBody" Style="{StaticResource FieldBox}" Height="92"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4000"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="Steps to reproduce (optional)" Style="{StaticResource Label}"/>
                <TextBox x:Name="txtSteps" Style="{StaticResource FieldBox}" Height="56"
                         AcceptsReturn="True" TextWrapping="Wrap" MaxLength="2000"
                         VerticalScrollBarVisibility="Auto" Margin="0,0,0,12"/>

                <TextBlock Text="Contact (optional - Discord handle or email if you want a reply)"
                           Style="{StaticResource Label}"/>
                <TextBox x:Name="txtContact" Style="{StaticResource FieldBox}" MaxLength="120"
                         Margin="0,0,0,14"/>

                <Border Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,0,0,5">
                    <StackPanel>
                        <CheckBox x:Name="chkDiagnostics" IsChecked="True"
                                  Content="Include diagnostics (app version, Windows, .NET, WebView2)"/>
                        <CheckBox x:Name="chkLog" IsChecked="True" Margin="0,0,0,2">
                            <TextBlock Text="Include error logs" FontSize="11" Foreground="#a6adc8"/>
                        </CheckBox>
                        <TextBlock x:Name="lblLogInfo" Text="" FontSize="10" Foreground="#585b70"
                                   Margin="20,0,0,6"/>
                        <TextBlock FontSize="10" Foreground="#585b70" TextWrapping="Wrap"
                                   Text="Before anything is sent or saved: C:\Users\yourname becomes &lt;user&gt;, and your install, content and log folders become &lt;path&gt;."/>
                    </StackPanel>
                </Border>

                <Button x:Name="btnPreview" Content="Preview exactly what is sent"
                        Style="{StaticResource DarkButton}" HorizontalAlignment="Left"
                        Click="Preview_Click"/>
                <TextBox x:Name="txtPreview" Style="{StaticResource FieldBox}" Height="200"
                         IsReadOnly="True" Visibility="Collapsed" Margin="0,6,0,0"
                         AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Consolas" FontSize="10"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
