<Window x:Class="SifuMovesetEditor.ProjectFeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SifuMovesetEditor"
        Title="Sifu Moveset Editor"
        Width="560" Height="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74a8f7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MoveCard" TargetType="Border">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="BorderBrush" Value="#585b70"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="ProjectUnitHeaderTemplate">
            <Border Style="{StaticResource MoveCard}" MouseLeftButtonDown="UnitHeader_Click" Tag="{Binding}">
                <DockPanel>
                    <Border Background="#89b4fa" Width="3" CornerRadius="2" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                    <TextBlock Text="▸" Foreground="#89b4fa" FontSize="12"
                               DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▸"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="▾"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel>
                        <TextBlock Text="{Binding Count}" Foreground="#6c7086" FontSize="11"
                                   DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="#89b4fa" FontSize="14"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#6c7086" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProjectSectionHeaderTemplate">
            <Border Style="{StaticResource MoveCard}" MouseLeftButtonDown="SectionHeader_Click" Tag="{Binding}"
                    Margin="16,1,4,1">
                <DockPanel>
                    <Border Background="#cba6f7" Width="3" CornerRadius="2" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                    <TextBlock Foreground="#cba6f7" FontSize="12"
                               DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▸"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="▾"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel>
                        <TextBlock Text="{Binding Count}" Foreground="#6c7086" FontSize="11"
                                   DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" Foreground="#cba6f7" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ProjectChangeRowTemplate">
            <Border Style="{StaticResource MoveCard}" Margin="32,1,4,1" Cursor="Arrow"
                    ToolTip="{Binding ToolTip}">
                <DockPanel>
                    <Border Width="3" CornerRadius="2" DockPanel.Dock="Left" Margin="0,0,10,0"
                            Background="#a6e3a1"/>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="4"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding Title}"
                                   FontWeight="SemiBold" Foreground="#cdd6f4"
                                   FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <Grid Grid.Row="2" Margin="0,2,0,0"
                              Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Foreground="#6c7086"
                                       FontSize="11" Text="{Binding DetailLeft}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="→"
                                       Foreground="#89b4fa" FontWeight="Bold" FontSize="11"/>
                            <TextBlock Grid.Column="2" Margin="6,0,0,0"
                                       Foreground="#a6e3a1" FontSize="11"
                                       Text="{Binding DetailRight}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Grid>
                </DockPanel>
            </Border>
        </DataTemplate>

        <local:MoveGroupTemplateSelector x:Key="MoveGroupSelector"
            EnemyHeaderTemplate="{StaticResource ProjectUnitHeaderTemplate}"
            WeaponHeaderTemplate="{StaticResource ProjectSectionHeaderTemplate}"
            MoveCardTemplate="{StaticResource ProjectChangeRowTemplate}"/>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Sifu Moveset Editor" FontSize="15" FontWeight="Bold"
                           Foreground="#89b4fa" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtModeLabel" Text="— Project" Foreground="#6c7086" FontSize="15"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="12,5">
            <TextBlock x:Name="txtStatus" Text="" Foreground="#6c7086" FontSize="11"/>
        </Border>

        <Grid Name="panelReview" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtTitle" Text="Project changes" FontSize="15"
                       FontWeight="Bold" Foreground="#cdd6f4" TextWrapping="Wrap"/>

            <TextBlock Grid.Row="2" x:Name="txtSummary" Text="" Foreground="#a6adc8"
                       FontSize="12" TextWrapping="Wrap"/>

            <Border Grid.Row="4" Background="#181825" CornerRadius="4"
                    BorderBrush="#313244" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#313244" Padding="10,6"
                            CornerRadius="4,4,0,0">
                        <TextBlock x:Name="txtChangeCount" Foreground="#a6adc8" FontSize="12"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl x:Name="lstChanges"
                                      ItemTemplateSelector="{StaticResource MoveGroupSelector}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="OK" Style="{StaticResource AccentButton}" Click="Ok_Click"
                        Padding="16,6" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
