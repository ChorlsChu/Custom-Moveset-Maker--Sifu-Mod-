<Window x:Class="SifuMovesetEditor.CreateAttackDbDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create AttackDB"
        Width="620" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#b4d0fb"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="Foreground" Value="#6c7086"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <!-- Same proven pattern as MainWindow/AttackDbEditorDialog: the default WPF
             combo chrome is light, so the text must be dark or it's invisible. -->
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1e1e2e"/>
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#cdd6f4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8" Margin="-16,-16,-16,12">
            <TextBlock Text="Create AttackDB" FontWeight="Bold"
                       Foreground="#89b4fa" FontSize="15"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnCancel" Style="{StaticResource DarkButton}"
                    Content="Cancel" Click="Cancel_Click" Padding="16,8"
                    MinHeight="30" MinWidth="80" IsCancel="True"/>
            <Button x:Name="btnCreate" Style="{StaticResource AccentButton}"
                    Content="Create" Click="Create_Click" Padding="16,8"
                    MinHeight="30" MinWidth="90" IsDefault="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#a6adc8" FontSize="11" LineHeight="16"
                       Margin="0,0,0,10">
                <Run Text="Copies a working attack card, renames it, and points its animation at "/>
                <Run x:Name="runAnimation" FontWeight="SemiBold" Foreground="#cdd6f4"/>
                <Run Text=". Vanilla files are never modified."/>
            </TextBlock>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Every field needs an explicit Grid.Row. Anything left on the default
                     row 0 stacks on top of the card-name field. -->
                <TextBlock Text="Card name" Grid.Row="0" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                <TextBox x:Name="txtName" Grid.Row="0" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                         MaxLength="48" Margin="0,0,0,8" TextChanged="Name_TextChanged"/>

                <TextBlock Text="Animation" Grid.Row="1" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                <TextBlock x:Name="txtAnimation" Grid.Row="1" Grid.Column="1" Foreground="#a6adc8"
                           FontSize="11" FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" Margin="0,0,0,8"/>

                <TextBlock Text="Template card" Grid.Row="2" Style="{StaticResource FieldLabel}" Margin="0,0,0,8"/>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,0,8">
                    <DockPanel>
                        <Button x:Name="btnPickTemplate" DockPanel.Dock="Right" Style="{StaticResource DarkButton}"
                                Content="Choose AttackDB Card in Library…" Padding="10,4" Margin="0"
                                FontSize="11" VerticalAlignment="Top" Click="PickTemplate_Click"/>
                        <StackPanel Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTemplateName" Foreground="#cdd6f4" FontSize="12"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="txtTemplateMeta" Foreground="#a6adc8" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="txtTemplateReason" Foreground="#a6adc8" FontSize="10"
                               TextWrapping="Wrap" Margin="0,4,0,0"/>
                </StackPanel>

                <TextBlock Text="Destination" Grid.Row="3" Style="{StaticResource FieldLabel}"/>
                <TextBlock x:Name="txtDestination" Grid.Row="3" Grid.Column="1" Foreground="#a6adc8"
                           FontSize="11" FontFamily="Consolas" TextWrapping="Wrap"/>
            </Grid>

            <Border x:Name="existingPanel" Background="#181825" CornerRadius="4"
                    Padding="10,8" Margin="0,10,0,0" Visibility="Collapsed">
                <TextBlock x:Name="txtExisting" Foreground="#f9e2af" FontSize="11"
                           TextWrapping="Wrap"/>
            </Border>

            <CheckBox x:Name="chkPrivate" Style="{StaticResource DarkCheckBox}"
                      IsChecked="True" Margin="0,12,0,0"
                      Content="Give the new card a private hit row (recommended)"
                      Checked="Private_Changed" Unchecked="Private_Changed"/>
            <TextBlock Foreground="#6c7086" FontSize="10" TextWrapping="Wrap" Margin="22,3,0,0"
                       Text="Creates its own HitBoxData table, so tuning damage or parry on this card never changes the template or other attacks."/>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Hit windows" Style="{StaticResource FieldLabel}"/>
                <ComboBox x:Name="cboHitMode" Grid.Column="1" Style="{StaticResource DarkComboBox}"
                          SelectionChanged="HitMode_Changed">
                    <ComboBoxItem Content="Copy from the template" Tag="copy"/>
                    <ComboBoxItem x:Name="itemScale" Content="Scale to this animation's length" Tag="scale"/>
                </ComboBox>
            </Grid>
            <TextBlock x:Name="txtHitHint" Foreground="#6c7086" FontSize="10"
                       TextWrapping="Wrap" Margin="120,3,0,0"/>

            <CheckBox x:Name="chkAdvanced" Style="{StaticResource DarkCheckBox}"
                      Content="Advanced" Margin="0,12,0,0"
                      Checked="Advanced_Changed" Unchecked="Advanced_Changed"/>
            <Grid x:Name="advancedPanel" Margin="22,8,0,0" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Hints get their own row: sharing a cell with the box put a transparent
                     TextBlock on top of it, which swallowed the clicks. -->
                <TextBlock Text="Buildup frames" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBox x:Name="txtBuildup" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,2" TextChanged="Name_TextChanged"/>
                <TextBlock x:Name="txtBuildupHint" Grid.Row="1" Grid.Column="1" Foreground="#6c7086"
                           FontSize="10" Margin="0,0,0,8" IsHitTestVisible="False"/>

                <TextBlock Text="Gameplay range" Style="{StaticResource FieldLabel}" Grid.Row="2" Margin="0,0,0,4"/>
                <TextBox x:Name="txtRange" Grid.Row="2" Grid.Column="1" Style="{StaticResource DarkTextBox}"
                         Margin="0,0,0,2" TextChanged="Name_TextChanged"/>
                <TextBlock x:Name="txtRangeHint" Grid.Row="3" Grid.Column="1" Foreground="#6c7086"
                           FontSize="10" IsHitTestVisible="False"/>
            </Grid>

            <Border Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                <TextBlock x:Name="txtPreview" Foreground="#a6adc8" FontSize="11"
                           FontFamily="Consolas" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="txtError" Foreground="#f38ba8" FontSize="11"
                       TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
