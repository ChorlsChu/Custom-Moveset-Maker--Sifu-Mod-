<Window x:Class="SifuMovesetEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:SifuMovesetEditor"
        Title="Sifu Moveset Editor" Width="1400" Height="800"
        WindowStartupLocation="CenterScreen"
        Background="#1e1e2e" Foreground="#cdd6f4"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing"
        PreviewKeyDown="MainWindow_PreviewKeyDown"
        PreviewKeyUp="MainWindow_PreviewKeyUp"
        PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#1e1e2e"/>
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="#cdd6f4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,4,4,2"/>
        </Style>
        <Style x:Key="MoveCard" TargetType="Border">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#45475a"/>
                    <Setter Property="BorderBrush" Value="#585b70"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="TagBadge" TargetType="Border">
            <Setter Property="Background" Value="#45475a"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="5,1"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
        </Style>

        <DataTemplate x:Key="EnemyHeaderTemplate">
            <Border Style="{StaticResource MoveCard}" MouseLeftButtonDown="EnemyHeader_Click" Tag="{Binding}">
                <DockPanel>
                    <Border Background="#89b4fa" Width="3" CornerRadius="2" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                    <TextBlock Name="txtExpandIcon" Text="▸" Foreground="#89b4fa" FontSize="12"
                               DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▸"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="▾"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel>
                        <TextBlock Text="{Binding Count}" Foreground="#6c7086" FontSize="11"
                                   DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="#89b4fa" FontSize="14"
                                       FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Subtitle}" Foreground="#6c7086" FontSize="10"
                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="WeaponHeaderTemplate">
            <Border Style="{StaticResource MoveCard}" MouseLeftButtonDown="WeaponHeader_Click" Tag="{Binding}"
                    Margin="16,1,4,1">
                <DockPanel>
                    <Border Background="#cba6f7" Width="3" CornerRadius="2" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                    <TextBlock Name="txtExpandIcon" Foreground="#cba6f7" FontSize="12"
                               DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="▸"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                        <Setter Property="Text" Value="▾"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <DockPanel>
                        <TextBlock Text="{Binding Count}" Foreground="#6c7086" FontSize="11"
                                   DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        <TextBlock Text="{Binding Name}" Foreground="#cba6f7" FontSize="13"
                                   FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="MoveCardTemplate">
            <Border Style="{StaticResource MoveCard}"
                    MouseLeftButtonDown="MoveCard_Click"
                    MouseMove="MoveCard_MouseMove"
                    Tag="{Binding}"
                    Margin="32,1,4,1">
                <DockPanel>
                    <Border Width="3" CornerRadius="2" DockPanel.Dock="Left" Margin="0,0,10,0"
                            Background="#a6e3a1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#a6e3a1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                        <Setter Property="Background" Value="#f38ba8"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                    <TextBlock Text="&#x2630;" DockPanel.Dock="Left"
                               Foreground="#585b70" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,10,0"
                               IsHitTestVisible="False"/>
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayNameClean}"
                                   Foreground="#cdd6f4" FontSize="12"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Border Style="{StaticResource TagBadge}">
                                <TextBlock Text="{Binding Character}"
                                           Foreground="#a6adc8" FontSize="9"/>
                            </Border>
                            <Border Style="{StaticResource TagBadge}">
                                <TextBlock Text="{Binding WeaponType}"
                                           Foreground="#a6adc8" FontSize="9"/>
                            </Border>
                            <Border Style="{StaticResource TagBadge}">
                                <TextBlock Text="{Binding Category}"
                                           Foreground="#a6adc8" FontSize="9"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <local:MoveGroupTemplateSelector x:Key="MoveGroupSelector"
            EnemyHeaderTemplate="{StaticResource EnemyHeaderTemplate}"
            WeaponHeaderTemplate="{StaticResource WeaponHeaderTemplate}"
            MoveCardTemplate="{StaticResource MoveCardTemplate}"/>

    </Window.Resources>

    <Grid>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Sifu Moveset Editor" FontSize="16" FontWeight="Bold"
                           Foreground="#89b4fa" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="New" Style="{StaticResource DarkButton}" Click="NewProject_Click"/>
                    <Button Content="Import Mod" Style="{StaticResource DarkButton}" Click="ImportMod_Click"/>
                    <Button Content="Save" Style="{StaticResource DarkButton}" Click="SaveProject_Click"/>
                    <Button Content="Load" Style="{StaticResource DarkButton}" Click="LoadProject_Click"/>
                    <Button Content="Settings" Style="{StaticResource DarkButton}" Click="Settings_Click"/>
                    <Button Content="Export Pak" Style="{StaticResource DarkButton}"
                            Click="ExportPak_Click" IsEnabled="False" Name="btnExport"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="12,5">
            <TextBlock Name="txtStatus" Text="Ready" Foreground="#6c7086" FontSize="11"/>
        </Border>

        <Grid>
            <!-- Main content -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="400"/>
                    <ColumnDefinition Width="3"/>
                    <ColumnDefinition Width="300" MinWidth="200"/>
                </Grid.ColumnDefinitions>

            <!-- Left panel: Combo Graph + Preview -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="100"/>
                    <RowDefinition Height="3"/>
                    <RowDefinition Height="*" MinHeight="100"/>
                </Grid.RowDefinitions>

                <!-- Combo Graph -->
                <Border x:Name="comboBorder" Grid.Row="0" Background="#181825" CornerRadius="0" Margin="0" ClipToBounds="True"
                        Focusable="True" PreviewMouseDown="ComboGraphBorder_PreviewMouseDown"
                        PreviewKeyDown="ComboBorder_PreviewKeyDown">
                    <Grid>
                        <Canvas Name="comboCanvas"
                                Background="Transparent"
                                PreviewMouseLeftButtonDown="ComboCanvas_PreviewMouseLeftButtonDown"
                                MouseLeftButtonDown="ComboCanvas_MouseLeftButtonDown"
                                MouseMove="ComboCanvas_MouseMove"
                                MouseLeftButtonUp="ComboCanvas_MouseLeftButtonUp"
                                PreviewMouseRightButtonDown="ComboCanvas_PreviewMouseRightButtonDown"
                                MinWidth="600" MinHeight="400">
                            <Canvas.RenderTransform>
                                <TranslateTransform x:Name="_comboTranslate" X="0" Y="0"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                        <Border Name="toastBorder" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                                Background="#313244" BorderBrush="#f38ba8" BorderThickness="1"
                                CornerRadius="6" Padding="12,6" Margin="0,0,0,8"
                                Visibility="Collapsed" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x26A0;" Foreground="#f38ba8" FontSize="12"
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Name="toastText" Foreground="#cdd6f4" FontSize="11"
                                           TextTrimming="CharacterEllipsis" MaxWidth="400"/>
                            </StackPanel>
                        </Border>
                        <Border Name="graphLoadingBorder" Visibility="Collapsed" IsHitTestVisible="False"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Background="#313244" BorderBrush="#585b70" BorderThickness="1"
                                CornerRadius="6" Padding="16,12">
                            <StackPanel>
                                <ProgressBar IsIndeterminate="True" Width="140" Height="4" Margin="0,0,0,8"/>
                                <TextBlock Name="graphLoadingText" Text="Loading..." Foreground="#cdd6f4" FontSize="11" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="comboToolbar" Background="#11111b" Padding="10,6"
                                VerticalAlignment="Top" IsHitTestVisible="False">
                            <DockPanel>
                                <TextBlock Text="Combo Graph" FontWeight="Bold"
                                           Foreground="#89b4fa" FontSize="13" VerticalAlignment="Center"/>
                                <Button Name="btnChangeUnit" Content="Change Unit" Style="{StaticResource DarkButton}"
                                        Click="BtnChangeUnit_Click" FontSize="11" Padding="8,4" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Width="110"/>
                                <Button Name="btnVariant" Content="Variant" Style="{StaticResource DarkButton}"
                                        Click="BtnVariant_Click" FontSize="11" Padding="8,4" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Width="90" Visibility="Collapsed"/>
                                <Button Name="btnWeaponVariant" Content="Weapon" Style="{StaticResource DarkButton}"
                                        Click="BtnWeaponVariant_Click" FontSize="11" Padding="8,4" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Width="90" Visibility="Collapsed"/>
                                <ComboBox Name="cmbStance" Visibility="Collapsed" Width="0" Height="0"/>
                                <Button Name="btnResetMode" Content="Reset Node Mode" Style="{StaticResource DarkButton}"
                                        Click="ToggleResetMode_Click" FontSize="11" Padding="8,3" Margin="8,0,0,0"
                                        Visibility="Collapsed"/>
                                <Button Name="btnUnitProperties" Content="Unit Properties" Style="{StaticResource DarkButton}"
                                        Click="BtnUnitProperties_Click" FontSize="11" Padding="8,3" Margin="8,0,0,0"
                                        Visibility="Collapsed" ToolTip="Edit health, structure, and defense behavior"/>
                                <Button Name="btnResetAll" Content="Reset All to Vanilla" Style="{StaticResource DarkButton}"
                                        Click="ResetAllToVanilla_Click" FontSize="11" Padding="8,3" Margin="8,0,0,0"
                                        Visibility="Collapsed"/>
                                <Button Content="&#x21bb;" Style="{StaticResource DarkButton}"
                                        Click="ResetComboCamera_Click" Padding="6,2" FontSize="11"
                                        VerticalAlignment="Center" Margin="8,0,0,0"
                                        ToolTip="Reset camera to default"/>
                                <TextBlock Name="txtComboInfo" Text="" Foreground="#6c7086" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                             </DockPanel>
    </Border>
    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="3" Background="#313244"
                              HorizontalAlignment="Stretch" ResizeDirection="Rows"/>

                <!-- Preview -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Timeline -->
                    <Border Grid.Row="0" Background="#181825" Padding="8,2">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                <Button Content="&#9654;" Style="{StaticResource DarkButton}"
                                        Click="Play_Click" Padding="6,2" FontSize="11"/>
                                <Button Content="&#9632;" Style="{StaticResource DarkButton}"
                                        Click="Stop_Click" Padding="6,2" FontSize="11"/>
                                <TextBlock Text="Speed:" Foreground="#6c7086" FontSize="11"
                                           VerticalAlignment="Center" Margin="8,0,4,0"/>
                                <ComboBox Name="cmbSpeed" Style="{StaticResource DarkComboBox}"
                                          Width="60" SelectionChanged="Speed_Changed" FontSize="11">
                                    <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                    <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                    <ComboBoxItem Content="1x" IsSelected="True" Tag="1"/>
                                    <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                    <ComboBoxItem Content="2x" Tag="2"/>
                                </ComboBox>
                            </StackPanel>
                            <TextBlock Name="txtFrameInfo" Text="Frame: 0/0" Foreground="#6c7086"
                                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <TextBlock Name="txtTimeInfo" Text="0.00s / 0.00s" Foreground="#6c7086"
                                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            <Slider Name="sliderTimeline" DockPanel.Dock="Right"
                                    Minimum="0" Maximum="100" Value="0"
                                    Width="200" HorizontalAlignment="Right"
                                    ValueChanged="Timeline_Changed"
                                    Margin="8,0"/>
                        </DockPanel>
                    </Border>
                    <!-- Info + 3D Preview -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="3"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Info Panel -->
                        <Border Grid.Column="0" Background="#181825" Padding="10">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>

                                <TextBlock Text="Animation Info" FontWeight="Bold"
                                           Foreground="#a6e3a1" FontSize="12" Margin="0,0,0,6"/>
                                <TextBlock Name="txtDisplayName" Text="Display: -" Foreground="#89b4fa"
                                           FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Name="txtAnimName" Text="Name: -" Foreground="#cdd6f4"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Name="txtAnimFrames" Text="Frames: -" Foreground="#cdd6f4"
                                           FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Name="txtAnimDuration" Text="Duration: -" Foreground="#cdd6f4"
                                           FontSize="11" Margin="0,4,0,0"/>
                                <TextBlock Name="txtAnimFPS" Text="FPS: -" Foreground="#cdd6f4"
                                           FontSize="11" Margin="0,4,0,0"/>
                                <Border Height="1" Background="#313244" Margin="0,10"/>
                                <TextBlock Text="Skeleton Info" FontWeight="Bold"
                                           Foreground="#f9e2af" FontSize="12" Margin="0,0,0,6"/>
                                <TextBlock Name="txtBoneCount" Text="Bones: -" Foreground="#cdd6f4"
                                           FontSize="11"/>
                                <TextBlock Name="txtFilePath" Text="Path: -" Foreground="#cdd6f4"
                                           FontSize="10" TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <GridSplitter Grid.Column="1" Width="3" Background="#313244"
                                      VerticalAlignment="Stretch"/>
                        <!-- 3D Preview -->
                        <Grid x:Name="previewAreaGrid" Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="32"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#181825" Padding="8,4">
                                <DockPanel LastChildFill="False">
                                    <CheckBox Name="chkShowLines" Content="Show Lines"
                                               Foreground="#6c7086" FontSize="11"
                                               VerticalAlignment="Center"
                                               IsChecked="True"
                                               Checked="ChkShowLines_Changed"
                                               Unchecked="ChkShowLines_Changed"/>
                                    <Button Content="&#x21bb;" Style="{StaticResource DarkButton}"
                                            Click="ResetCamera_Click" Padding="6,2" FontSize="11"
                                            VerticalAlignment="Center" Margin="12,0,0,0"
                                            ToolTip="Reset camera to default"/>
                                </DockPanel>
                            </Border>
                            <wv2:WebView2 x:Name="webView" Grid.Row="1"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="3" Background="#313244"
                          VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>

            <!-- Right panel: Move Library -->
            <Border Grid.Column="2" Background="#181825" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#11111b" Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="Move Library" FontWeight="Bold"
                                       Foreground="#cba6f7" VerticalAlignment="Center"/>
                            <TextBlock Name="txtMoveCount" Text="0 moves"
                                       Foreground="#6c7086" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="6,4" Background="#11111b">
                        <DockPanel>
                            <TextBox Name="txtSearch" Style="{StaticResource DarkTextBox}"
                                     TextChanged="Search_Changed"
                                     Width="240" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </Border>
                    <TabControl Name="tabMoves" Background="Transparent" BorderThickness="0"
                                SelectionChanged="TabChanged">
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <Grid KeyboardNavigation.DirectionalNavigation="Local">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <UniformGrid Grid.Row="0" Columns="2" Rows="2"
                                                 IsItemsHost="True" Panel.ZIndex="1"/>
                                    <Border Grid.Row="1" KeyboardNavigation.TabNavigation="Local"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}">
                                        <ContentPresenter ContentSource="SelectedContent"/>
                                    </Border>
                                </Grid>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabControl.Resources>
                            <Style TargetType="TabItem">
                                <Setter Property="Foreground" Value="#6c7086"/>
                                <Setter Property="Background" Value="#181825"/>
                                <Setter Property="Padding" Value="12,6"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Foreground" Value="#1e1e2e"/>
                                        <Setter Property="Background" Value="#cdd6f4"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TabControl.Resources>
                        <!-- Visual order: Other | Custom / Vanilla | Stances -->
                        <TabItem x:Name="tabOther">
                            <TabItem.Header>
                                <TextBlock Name="tabHeaderUnused" Text="Other Attacks"/>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <ItemsControl Name="listUnused" Padding="4"
                                              ItemTemplateSelector="{StaticResource MoveGroupSelector}"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="tabCustom">
                            <TabItem.Header>
                                <TextBlock Name="tabHeaderCustom" Text="Custom Moves"/>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <ItemsControl Name="listCustom" Padding="4"
                                              ItemTemplateSelector="{StaticResource MoveGroupSelector}"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="tabVanilla">
                            <TabItem.Header>
                                <TextBlock Name="tabHeaderVanilla" Text="Vanilla Attacks"/>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <ItemsControl Name="listVanilla" Padding="4"
                                              ItemTemplateSelector="{StaticResource MoveGroupSelector}"/>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem x:Name="tabStances">
                            <TabItem.Header>
                                <TextBlock Name="tabHeaderLoco" Text="Stances"/>
                            </TabItem.Header>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
                                <ItemsControl Name="listLoco" Padding="4">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource MoveCard}"
                                                    MouseLeftButtonDown="MoveCard_Click"
                                                    MouseMove="MoveCard_MouseMove"
                                                    Tag="{Binding}">
                                <DockPanel LastChildFill="False">
                                                    <TextBlock Text="&#x2630;" DockPanel.Dock="Left"
                                                               Foreground="#585b70" FontSize="13"
                                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                                               IsHitTestVisible="False"/>
                                                    <StackPanel>
                        <TextBlock Text="{Binding DisplayName}"
                                                                    Foreground="#cdd6f4" FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                            <Border Style="{StaticResource TagBadge}">
                                                                <TextBlock Text="{Binding Character}"
                                                                           Foreground="#a6adc8" FontSize="9"/>
                                                            </Border>
                                                            <Border Style="{StaticResource TagBadge}">
                                                                <TextBlock Text="{Binding WeaponType}"
                                                                           Foreground="#a6adc8" FontSize="9"/>
                                                            </Border>
                                                            <Border Style="{StaticResource TagBadge}">
                                                                <TextBlock Text="{Binding Category}"
                                                                           Foreground="#a6adc8" FontSize="9"/>
                                                            </Border>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </DockPanel>
        </Border>
    </Grid>
    </Grid>
    </DockPanel>

    <!-- Loading overlay (on top of everything) -->
    <Grid Name="loadingOverlay" Visibility="Visible" IsHitTestVisible="True">
        <Border Background="#1e1e2e" Opacity="0.95">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True" Width="260" Height="4"
                             Foreground="#89b4fa" Background="#313244"/>
                <TextBlock Name="loadingText" Text="Loading animations..."
                           Foreground="#cdd6f4" FontSize="14" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBlock Name="loadingDetail" Text=""
                           Foreground="#6c7086" FontSize="11"
                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- Settings overlay -->
    <Grid Name="settingsOverlay" Visibility="Collapsed" IsHitTestVisible="True" Background="#99000000" MouseLeftButtonDown="SettingsOverlay_Click" Panel.ZIndex="10">
        <Border Background="#1e1e2e" CornerRadius="6" BorderBrush="#585b70" BorderThickness="1" Width="520" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16">
            <StackPanel>
                <TextBlock Text="Settings" Foreground="#89b4fa" FontWeight="Bold" FontSize="14" Margin="0,0,0,12"/>
                <TextBlock Text="Content Path (Sifu/Content - pakchunk0/Sifu):" Foreground="#6c7086" FontSize="11" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,8">
                    <Button Content="Reset" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,3" Click="ResetSettings_Click" Style="{StaticResource DarkButton}" ToolTip="Delete settings.json and vanilla folder"/>
                    <Button Content="Browse..." DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,3" Click="BrowseContent_Click" Style="{StaticResource DarkButton}"/>
                    <TextBox Name="txtSettingsContentPath" Background="#313244" Foreground="#cdd6f4" Padding="6,3" FontSize="11"/>
                </DockPanel>
                <TextBlock Text="Output Path (ExportedMods - app dir):" Foreground="#6c7086" FontSize="11" Margin="0,0,0,4"/>
                <DockPanel Margin="0,0,0,12">
                    <Button Content="Browse..." DockPanel.Dock="Right" Margin="6,0,0,0" Padding="8,3" Click="BrowseOutput_Click" Style="{StaticResource DarkButton}"/>
                    <TextBox Name="txtSettingsOutputPath" Background="#313244" Foreground="#cdd6f4" Padding="6,3" FontSize="11"/>
                </DockPanel>
                <CheckBox Name="chkVerboseLog" Content="Verbose ErrorLog" Foreground="#6c7086" FontSize="11" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel" Padding="12,4" Click="CancelSettings_Click" Style="{StaticResource DarkButton}" Margin="0,0,6,0"/>
                    <Button Content="Save" Padding="12,4" Click="SaveSettings_Click" Style="{StaticResource DarkButton}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
    <Border Name="unitPopupBorder" Visibility="Collapsed" Background="#99000000"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="100"
            MouseLeftButtonDown="UnitPopupBackground_Click">
        <Border Background="#1e1e2e" CornerRadius="6" BorderBrush="#585b70" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="12" MaxWidth="560">
            <StackPanel>
                <TextBlock Text="Select Unit" Foreground="#89b4fa" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="580">
                    <WrapPanel Name="unitWrapPanel" Orientation="Horizontal"/>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Border>
    <Border Name="variantPopupBorder" Visibility="Collapsed" Background="#99000000"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="100"
            MouseLeftButtonDown="VariantPopupBackground_Click">
        <Border Background="#1e1e2e" CornerRadius="6" BorderBrush="#585b70" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="12" MaxWidth="400">
            <StackPanel>
                <TextBlock Name="variantPopupTitle" Text="Select Variant" Foreground="#89b4fa" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <WrapPanel Name="variantWrapPanel" Orientation="Horizontal"/>
            </StackPanel>
        </Border>
    </Border>
    <Border Name="weaponPopupBorder" Visibility="Collapsed" Background="#99000000"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="100"
            MouseLeftButtonDown="WeaponPopupBackground_Click">
        <Border Background="#1e1e2e" CornerRadius="6" BorderBrush="#585b70" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="12" MaxWidth="400">
            <StackPanel>
                <TextBlock Name="weaponPopupTitle" Text="Select Weapon" Foreground="#a6e3a1" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" HorizontalAlignment="Center"/>
                <WrapPanel Name="weaponWrapPanel" Orientation="Horizontal"/>
            </StackPanel>
        </Border>
    </Border>
    <Border Name="unitPropsPopupBorder" Visibility="Collapsed" Background="#99000000"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="100"
            MouseLeftButtonDown="UnitPropsPopupBackground_Click">
        <Border Background="#1e1e2e" CornerRadius="6" BorderBrush="#585b70" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="16" Width="440">
            <StackPanel>
                <TextBlock Name="unitPropsTitle" Text="Unit Properties" Foreground="#89b4fa"
                           FontWeight="Bold" FontSize="14" Margin="0,0,0,12" HorizontalAlignment="Center"/>

                <TextBlock Text="ArchetypeDB" Foreground="#89b4fa" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Health:" Width="120" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="11"/>
                    <TextBox Name="txtUnitHealth" Width="120" Background="#313244" Foreground="#cdd6f4" Padding="6,3" FontSize="11" BorderBrush="#585b70" BorderThickness="1"/>
                    <Button Name="btnInfoHealth" Tag="Health" Click="UnitPropsInfo_Click" Margin="6,0,0,0" Width="16" Height="16" Padding="0" Cursor="Help">
                        <TextBlock Text="?" FontWeight="Bold" Foreground="#89b4fa" Background="#313244" Width="16" Height="16" TextAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </DockPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock Text="Structure:" Width="120" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="11"/>
                    <TextBox Name="txtUnitStructure" Width="120" Background="#313244" Foreground="#cdd6f4" Padding="6,3" FontSize="11" BorderBrush="#585b70" BorderThickness="1"/>
                    <Button Name="btnInfoStructure" Tag="Structure" Click="UnitPropsInfo_Click" Margin="6,0,0,0" Width="16" Height="16" Padding="0" Cursor="Help">
                        <TextBlock Text="?" FontWeight="Bold" Foreground="#89b4fa" Background="#313244" Width="16" Height="16" TextAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </DockPanel>

                <TextBlock Text="ContextDefense" Foreground="#89b4fa" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Memory Limit:" Width="120" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="11"/>
                    <TextBox Name="txtMemoryLimit" Width="100" Background="#313244" Foreground="#cdd6f4" Padding="6,3" FontSize="11" BorderBrush="#585b70" BorderThickness="1"/>
                    <TextBlock Text="s" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#6c7086" FontSize="11"/>
                    <Button Name="btnInfoMemoryLimit" Tag="MemoryLimit" Click="UnitPropsInfo_Click" Margin="6,0,0,0" Width="16" Height="16" Padding="0" Cursor="Help">
                        <TextBlock Text="?" FontWeight="Bold" Foreground="#89b4fa" Background="#313244" Width="16" Height="16" TextAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Hits Count:" Width="120" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="11"/>
                    <TextBox Name="txtHitsCount" Width="100" Background="#313244" Foreground="#cdd6f4" Padding="6,3" FontSize="11" BorderBrush="#585b70" BorderThickness="1"/>
                    <Button Name="btnInfoHitsCount" Tag="HitsCount" Click="UnitPropsInfo_Click" Margin="6,0,0,0" Width="16" Height="16" Padding="0" Cursor="Help">
                        <TextBlock Text="?" FontWeight="Bold" Foreground="#89b4fa" Background="#313244" Width="16" Height="16" TextAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </DockPanel>
                <DockPanel Margin="0,0,0,6">
                    <TextBlock Text="Flush Limit:" Width="120" VerticalAlignment="Center" Foreground="#cdd6f4" FontSize="11"/>
                    <TextBox Name="txtFlushLimit" Width="100" Background="#313244" Foreground="#cdd6f4" Padding="6,3" FontSize="11" BorderBrush="#585b70" BorderThickness="1"/>
                    <TextBlock Text="s" Margin="4,0,0,0" VerticalAlignment="Center" Foreground="#6c7086" FontSize="11"/>
                    <Button Name="btnInfoFlushLimit" Tag="FlushLimit" Click="UnitPropsInfo_Click" Margin="6,0,0,0" Width="16" Height="16" Padding="0" Cursor="Help">
                        <TextBlock Text="?" FontWeight="Bold" Foreground="#89b4fa" Background="#313244" Width="16" Height="16" TextAlignment="Center" FontSize="10" VerticalAlignment="Center"/>
                    </Button>
                </DockPanel>

                <Button Content="Reset to Defaults" HorizontalAlignment="Center"
                        Click="ResetUnitProps_Click" Style="{StaticResource DarkButton}" Padding="16,4" Margin="0,0,0,4"/>
            </StackPanel>
        </Border>
    </Border>
    <Border Name="unitPropsInfoPopup" Visibility="Collapsed" Background="#99000000"
            VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Panel.ZIndex="101"
            MouseLeftButtonDown="UnitPropsInfoPopup_Click">
        <Border Background="#1e1e2e" CornerRadius="6" BorderBrush="#89b4fa" BorderThickness="1"
                VerticalAlignment="Center" HorizontalAlignment="Center" Padding="14" Width="320">
            <StackPanel>
                <TextBlock Name="unitPropsInfoTitle" Text="" Foreground="#89b4fa"
                           FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Name="unitPropsInfoDesc" Text="" Foreground="#cdd6f4"
                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <DockPanel Name="unitPropsInfoRange" Visibility="Collapsed">
                    <TextBlock Text="Range:" Width="50" Foreground="#6c7086" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Name="unitPropsInfoRangeValue" Text="" Foreground="#a6e3a1" FontSize="11" VerticalAlignment="Center"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>
