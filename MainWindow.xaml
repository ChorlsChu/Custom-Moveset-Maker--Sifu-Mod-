<Window x:Class="SifuMovesetEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Sifu Moveset Editor" Height="800" Width="1400"
        Background="#1e1e2e" Foreground="#cdd6f4"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#45475a"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style x:Key="DarkListBoxItem" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" 
                                Padding="{TemplateBinding Padding}" CornerRadius="3">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#313244"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkListBox" TargetType="ListBox">
            <Setter Property="Background" Value="#181825"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#a6adc8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,4,4,2"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top Bar -->
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="8,6">
            <DockPanel>
                <TextBlock Text="Sifu Moveset Editor" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="#89b4fa" VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button Content="Settings" Style="{StaticResource DarkButton}" 
                            Click="Settings_Click"/>
                    <Button Content="Export Pak" Style="{StaticResource DarkButton}" 
                            Click="ExportPak_Click" IsEnabled="False" Name="btnExport"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="8,4">
            <TextBlock Name="txtStatus" Text="Ready" Foreground="#6c7086" FontSize="11"/>
        </Border>

        <!-- Main Content -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*" MinWidth="400"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Move Library -->
            <Border Grid.Column="0" Background="#181825" Padding="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#11111b" Padding="8,6">
                        <DockPanel>
                            <TextBlock Text="Move Library" FontWeight="Bold" 
                                       Foreground="#cba6f7" VerticalAlignment="Center"/>
                            <TextBlock Name="txtMoveCount" Text="0 moves" 
                                       Foreground="#6c7086" FontSize="11"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="6,4" Background="#11111b">
                        <TextBox Name="txtSearch" Style="{StaticResource DarkTextBox}"
                                 TextChanged="Search_Changed" 
                                 Width="280" HorizontalAlignment="Left"/>
                    </Border>
                    <Border DockPanel.Dock="Top" Padding="6,4" Background="#11111b">
                        <ComboBox Name="cmbFilter" Style="{StaticResource DarkComboBox}"
                                  SelectionChanged="Filter_Changed" Width="280" 
                                  HorizontalAlignment="Left">
                            <ComboBoxItem Content="All Characters" IsSelected="True"/>
                            <ComboBoxItem Content="Player (MainChar)"/>
                            <ComboBoxItem Content="Grunt"/>
                            <ComboBoxItem Content="FireDisciple"/>
                            <ComboBoxItem Content="FlashKick"/>
                            <ComboBoxItem Content="BigGuy"/>
                            <ComboBoxItem Content="BodyGuard"/>
                            <ComboBoxItem Content="Servant"/>
                            <ComboBoxItem Content="Bosses"/>
                        </ComboBox>
                    </Border>
                    <TreeView Name="treeMoves" Background="Transparent" 
                              BorderThickness="0" Foreground="#cdd6f4"
                              SelectedItemChanged="TreeMove_Selected"
                              Padding="4">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#cdd6f4"/>
                                <Setter Property="FontSize" Value="12"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#45475a"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="3" Background="#313244"
                          HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          ResizeBehavior="PreviousAndNext"/>

            <!-- Right Panel: Animation Preview + Controls -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="300"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <!-- 3D Preview + Character Selector -->
                <Border Grid.Row="0" Background="#11111b" Margin="4">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="6,4" Background="#11111b">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Character:" Foreground="#6c7086" 
                                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Name="cmbCharacter" Style="{StaticResource DarkComboBox}"
                                          Width="150" SelectionChanged="Character_Changed">
                                    <ComboBoxItem Content="None" IsSelected="True" Tag=""/>
                                </ComboBox>
                                <CheckBox Name="chkShowMesh" Content="Show Mesh" 
                                          Foreground="#6c7086" VerticalAlignment="Center" 
                                          Margin="12,0,0,0" IsChecked="True"/>
                            </StackPanel>
                        </Border>
                        <wv2:WebView2 Name="webView" />
                    </DockPanel>
                </Border>

                <!-- Timeline -->
                <Border Grid.Row="1" Background="#181825" Padding="8,4" Margin="4,0,4,4">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" 
                                    VerticalAlignment="Center">
                            <Button Name="btnPlay" Content="&#9654;" Style="{StaticResource DarkButton}"
                                    Width="36" FontSize="14" Click="Play_Click"/>
                            <Button Name="btnStop" Content="&#9632;" Style="{StaticResource DarkButton}"
                                    Width="36" FontSize="14" Click="Stop_Click"/>
                            <TextBlock Text="Speed:" Foreground="#6c7086" 
                                       VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <ComboBox Name="cmbSpeed" Style="{StaticResource DarkComboBox}" 
                                      Width="60" SelectionChanged="Speed_Changed"
                                      SelectedIndex="2">
                                <ComboBoxItem Content="0.25x" Tag="0.25"/>
                                <ComboBoxItem Content="0.5x" Tag="0.5"/>
                                <ComboBoxItem Content="1x" Tag="1.0"/>
                                <ComboBoxItem Content="1.5x" Tag="1.5"/>
                                <ComboBoxItem Content="2x" Tag="2.0"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Name="txtFrameInfo" Text="Frame: 0 / 0" 
                                       Foreground="#a6adc8" FontSize="11" Margin="8,0"/>
                            <TextBlock Name="txtTimeInfo" Text="0.00s / 0.00s" 
                                       Foreground="#a6adc8" FontSize="11"/>
                        </StackPanel>
                        <Slider Name="sliderTimeline" Minimum="0" Maximum="100" Value="0"
                                ValueChanged="Timeline_Changed"
                                TickPlacement="BottomRight" TickFrequency="1"
                                IsSnapToTickEnabled="False" Margin="4,0"/>
                    </DockPanel>
                </Border>

                <!-- Info Panel -->
                <Border Grid.Row="2" Background="#181825" Margin="4,0,4,4" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Animation Info" FontWeight="Bold" 
                                       Foreground="#a6e3a1" Margin="0,0,0,4"/>
                            <TextBlock Name="txtAnimName" Text="Name: -" 
                                       Foreground="#cdd6f4" FontSize="11"/>
                            <TextBlock Name="txtAnimFrames" Text="Frames: -" 
                                       Foreground="#cdd6f4" FontSize="11"/>
                            <TextBlock Name="txtAnimDuration" Text="Duration: -" 
                                       Foreground="#cdd6f4" FontSize="11"/>
                            <TextBlock Name="txtAnimFPS" Text="FPS: -" 
                                       Foreground="#cdd6f4" FontSize="11"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Skeleton Info" FontWeight="Bold" 
                                       Foreground="#f9e2af" Margin="0,0,0,4"/>
                            <TextBlock Name="txtBoneCount" Text="Bones: -" 
                                       Foreground="#cdd6f4" FontSize="11"/>
                            <TextBlock Name="txtFilePath" Text="Path: -" 
                                       Foreground="#cdd6f4" FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
