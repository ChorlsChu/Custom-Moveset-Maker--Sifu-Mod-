<Window x:Class="SifuMovesetEditor.Custom.CustomAssetsConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sifu Moveset Editor — CustomAssets"
        Width="560" Height="400"
        WindowStartupLocation="CenterOwner"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8" Margin="-16,-16,-16,12">
            <TextBlock Text="File(s) exist in CustomAssets" FontWeight="Bold"
                       Foreground="#89b4fa" FontSize="15"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel Load" Style="{StaticResource DarkButton}"
                    Click="CancelLoad_Click" Padding="16,8" MinHeight="30" MinWidth="110"
                    IsCancel="True"/>
            <Button Content="Skip" Style="{StaticResource DarkButton}"
                    Click="Skip_Click" Padding="16,8" MinHeight="30" MinWidth="90"/>
            <Button Content="Replace All" Style="{StaticResource AccentButton}"
                    Click="ReplaceAll_Click" Padding="16,8" MinHeight="30" MinWidth="120"
                    IsDefault="True"/>
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock TextWrapping="Wrap" Foreground="#cdd6f4" FontSize="12" LineHeight="18"
                       Margin="0,0,0,8"
                       Text="File(s) in this project already exist in CustomAssets with different content. Replace them with the project's copies? Skip keeps your current files; Cancel aborts loading."/>

            <ListBox Grid.Row="1" x:Name="listFiles"
                     Background="#11111b" Foreground="#a6adc8"
                     BorderBrush="#313244" BorderThickness="1"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     FontFamily="Consolas" FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</Window>
