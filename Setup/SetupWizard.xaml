<Window x:Class="SifuMovesetEditor.Setup.SetupWizard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sifu Moveset Editor — Setup"
        Width="520" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74a8f7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RadioDark" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Sifu Moveset Editor" FontSize="15" FontWeight="Bold"
                           Foreground="#89b4fa" VerticalAlignment="Center"/>
                <TextBlock Text="— Setup" Foreground="#6c7086" FontSize="15"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="12,5">
            <TextBlock Name="txtStatus" Text="Select your Sifu game folder to begin."
                       Foreground="#6c7086" FontSize="11"/>
        </Border>

        <!-- State 1: Select Folder -->
        <Grid Name="panelSelect" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Description -->
            <TextBlock Grid.Row="0" TextWrapping="Wrap" FontSize="13" Foreground="#cdd6f4">
                <Run Text="This tool requires game assets from "/>
                <Run Text="Sifu" FontWeight="Bold"/>
                <Run Text=". You must own the game."/>
            </TextBlock>

            <!-- Radio buttons -->
            <StackPanel Grid.Row="2">
                <RadioButton x:Name="rbGameDir" Content="I have Sifu installed (select game folder)"
                             IsChecked="True" Style="{StaticResource RadioDark}"/>
                <RadioButton x:Name="rbExtractedDir" Content="I already have extracted game content"
                             Style="{StaticResource RadioDark}"/>
            </StackPanel>

            <!-- Folder selector -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#313244" CornerRadius="4" Padding="1">
                    <TextBox x:Name="txtFolderPath" Background="Transparent"
                             Foreground="#cdd6f4" BorderThickness="0"
                             IsReadOnly="True" Padding="8,6" FontSize="13"
                             VerticalContentAlignment="Center"/>
                </Border>
                <Button Grid.Column="2" Content="Browse" Style="{StaticResource DarkButton}"
                        Click="Browse_Click" Padding="16,6"/>
            </Grid>

            <!-- Validation message -->
            <Border Grid.Row="6" Background="#313244" CornerRadius="4" Padding="10,8">
                <TextBlock x:Name="txtValidation" TextWrapping="Wrap" FontSize="12"
                           Foreground="#6c7086" Text="Select a folder to continue."/>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Skip" Style="{StaticResource DarkButton}"
                        Click="Skip_Click" Padding="16,6"/>
                <Button x:Name="btnExtract" Content="Extract ~460 MB"
                        Style="{StaticResource AccentButton}" Click="Extract_Click"
                        IsEnabled="False" Padding="16,6"/>
            </StackPanel>
        </Grid>

        <!-- State 2: Extracting -->
        <Grid Name="panelExtracting" Visibility="Collapsed" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Extracting game assets..." FontSize="15"
                       FontWeight="Bold" Foreground="#cdd6f4"/>

            <!-- Progress bar -->
            <Border Grid.Row="2" Background="#313244" CornerRadius="6" Height="32"
                    Padding="2">
                <Grid>
                    <Border CornerRadius="4" ClipToBounds="True">
                        <Border x:Name="progressFill" Background="#89b4fa"
                                HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <TextBlock x:Name="txtProgress" Text="0%"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Bold" Foreground="#1e1e2e"/>
                </Grid>
            </Border>

            <!-- Current file -->
            <TextBlock x:Name="txtCurrentFile" Grid.Row="4" TextWrapping="Wrap"
                       FontSize="12" Foreground="#6c7086" Margin="0,4,0,0"/>

            <!-- File count -->
            <TextBlock x:Name="txtFileCount" Grid.Row="5" FontSize="12"
                       Foreground="#a6adc8" VerticalAlignment="Top"/>
        </Grid>

        <!-- State 3: Complete -->
        <Grid Name="panelComplete" Visibility="Collapsed" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold">
                <Run Text="✓ " Foreground="#a6e3a1"/>
                <Run Text="Setup complete!" Foreground="#cdd6f4"/>
            </TextBlock>

            <TextBlock x:Name="txtSummary" Grid.Row="2" TextWrapping="Wrap"
                       FontSize="13" Foreground="#a6adc8"/>

            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnLaunch" Content="Launch Editor"
                        Style="{StaticResource AccentButton}" Click="Launch_Click"
                        Padding="16,6"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>