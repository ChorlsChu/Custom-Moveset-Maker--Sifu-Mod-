<Window x:Class="SifuMovesetEditor.Export.ExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sifu Moveset Editor — Export"
        Width="520" Height="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74a8f7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Sifu Moveset Editor" FontSize="15" FontWeight="Bold"
                           Foreground="#89b4fa" VerticalAlignment="Center"/>
                <TextBlock Text="— Export" Foreground="#6c7086" FontSize="15"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="12,5">
            <TextBlock Name="txtStatus" Text="Review changes before exporting."
                       Foreground="#6c7086" FontSize="11"/>
        </Border>

        <!-- State 1: Review Changes -->
        <Grid Name="panelReview" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Export Combo Mod" FontSize="15"
                       FontWeight="Bold" Foreground="#cdd6f4"/>

            <!-- Changes list -->
            <Border Grid.Row="2" Background="#181825" CornerRadius="4"
                    BorderBrush="#313244" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#313244" Padding="10,6"
                            CornerRadius="4,4,0,0">
                        <TextBlock x:Name="txtChangeCount" Foreground="#a6adc8" FontSize="12"/>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl x:Name="lstChanges">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="Transparent" Padding="8,6"
                                            BorderBrush="#313244" BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="4"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding DisplayName}"
                                                       FontWeight="SemiBold" Foreground="#cdd6f4"
                                                       FontSize="13"/>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Foreground="#6c7086"
                                                           FontSize="12" Text="{Binding DefaultAnimPath}"/>
                                                <TextBlock Grid.Column="2" Text="→"
                                                           Foreground="#89b4fa" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="2" Margin="14,0,0,0"
                                                           Foreground="#a6e3a1" FontSize="12"
                                                           Text="{Binding AnimPath}"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Output path -->
            <TextBlock Grid.Row="4" x:Name="txtOutput" FontSize="12" Foreground="#6c7086"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource DarkButton}"
                        Click="Cancel_Click" Padding="16,6"/>
                <Button x:Name="btnConfirm" Content="Export &amp; Install"
                        Style="{StaticResource AccentButton}" Click="Confirm_Click"
                        Padding="16,6"/>
            </StackPanel>
        </Grid>

        <!-- State 2: Exporting -->
        <Grid Name="panelExporting" Visibility="Collapsed" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Building mod..." FontSize="15"
                       FontWeight="Bold" Foreground="#cdd6f4"/>

            <!-- Progress bar -->
            <Border Grid.Row="2" Background="#313244" CornerRadius="6" Height="32"
                    Padding="2">
                <Grid>
                    <Border CornerRadius="4" ClipToBounds="True">
                        <Border x:Name="progressFill" Background="#89b4fa"
                                HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <TextBlock x:Name="txtProgress" Text="0%"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Bold" Foreground="#1e1e2e"/>
                </Grid>
            </Border>

            <!-- Step checklist -->
            <StackPanel x:Name="stepList" Grid.Row="4" Margin="0,8,0,0">
                <TextBlock x:Name="step1" Text="○ Copying files" Foreground="#6c7086"
                           FontSize="12" Margin="0,2"/>
                <TextBlock x:Name="step2" Text="○ Patching imports" Foreground="#6c7086"
                           FontSize="12" Margin="0,2"/>
                <TextBlock x:Name="step3" Text="○ Building pak" Foreground="#6c7086"
                           FontSize="12" Margin="0,2"/>
            </StackPanel>

            <!-- Current action -->
            <TextBlock x:Name="txtCurrentAction" Grid.Row="5" TextWrapping="Wrap"
                       FontSize="12" Foreground="#6c7086" Margin="0,8,0,0"/>
        </Grid>

        <!-- State 3: Complete -->
        <Grid Name="panelComplete" Visibility="Collapsed" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold">
                <Run Text="✓ " Foreground="#a6e3a1"/>
                <Run Text="Export complete!" Foreground="#cdd6f4"/>
            </TextBlock>

            <TextBlock x:Name="txtResult" Grid.Row="2" FontSize="13"
                       Foreground="#cdd6f4" TextWrapping="Wrap"/>

            <TextBlock x:Name="txtInstallPath" Grid.Row="3" FontSize="12"
                       Foreground="#6c7086" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnOpenFolder" Content="Open Folder"
                        Style="{StaticResource DarkButton}" Click="OpenFolder_Click"
                        Padding="16,8" MinHeight="30"/>
                <Button Content="Close" Style="{StaticResource AccentButton}"
                        Click="Close_Click" Padding="16,8" MinHeight="30"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
