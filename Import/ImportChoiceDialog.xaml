<Window x:Class="SifuMovesetEditor.Import.ImportChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sifu Moveset Editor — Import"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8" Margin="-16,-16,-16,12">
            <TextBlock Text="Project already has changes" FontWeight="Bold"
                       Foreground="#89b4fa" FontSize="15"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Style="{StaticResource DarkButton}"
                    Click="Cancel_Click" Padding="16,8" MinHeight="30" MinWidth="80"/>
            <Button Content="Start Fresh" Style="{StaticResource DarkButton}"
                    Click="Fresh_Click" Padding="16,8" MinHeight="30" MinWidth="90"/>
            <Button Content="Merge" Style="{StaticResource AccentButton}"
                    Click="Merge_Click" Padding="16,8" MinHeight="30" MinWidth="80"
                    IsDefault="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="#cdd6f4" FontSize="12" LineHeight="18">
                This project already has imported mods, local edits, or a loaded project.
                Choose how to bring in this new pak.
            </TextBlock>

            <Border Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="Merge" FontWeight="SemiBold" Foreground="#a6e3a1" FontSize="12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#a6adc8" FontSize="11" Margin="0,3,0,0"
                               Text="Keep existing unit graphs, Custom cards, and harvested anims. This pak overwrites only matching units; other units stay."/>
                </StackPanel>
            </Border>

            <Border Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Start Fresh" FontWeight="SemiBold" Foreground="#f9e2af" FontSize="12"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#a6adc8" FontSize="11" Margin="0,3,0,0"
                               Text="Discard current project changes (units, Custom list, harvested anims), then import only this pak."/>
                </StackPanel>
            </Border>
        </StackPanel>
    </DockPanel>
</Window>
