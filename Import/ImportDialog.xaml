<Window x:Class="SifuMovesetEditor.Import.ImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sifu Moveset Editor — Import Mod"
        Width="480" Height="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#b4d0fb"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#74a8f7"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8">
            <DockPanel>
                <TextBlock Text="Sifu Moveset Editor" FontSize="15" FontWeight="Bold"
                           Foreground="#89b4fa" VerticalAlignment="Center"/>
                <TextBlock Text="— Import Mod" Foreground="#6c7086" FontSize="15"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </DockPanel>
        </Border>

        <!-- Status Bar -->
        <Border DockPanel.Dock="Bottom" Background="#11111b" Padding="12,5">
            <TextBlock x:Name="txtStatus" Text="Loading mod..."
                       Foreground="#6c7086" FontSize="11"/>
        </Border>

        <!-- State 1: Loading -->
        <Grid x:Name="panelLoading" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtTitle" Text="Importing mod..." FontSize="15"
                       FontWeight="Bold" Foreground="#cdd6f4"/>

            <!-- Progress bar -->
            <Border Grid.Row="2" Background="#313244" CornerRadius="6" Height="32"
                    Padding="2">
                <Grid>
                    <Border CornerRadius="4" ClipToBounds="True">
                        <Border x:Name="progressFill" Background="#89b4fa"
                                HorizontalAlignment="Left" Width="0"/>
                    </Border>
                    <TextBlock x:Name="txtProgress" Text="0%"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="12" FontWeight="Bold" Foreground="#1e1e2e"/>
                </Grid>
            </Border>

            <!-- Step checklist -->
            <StackPanel x:Name="stepList" Grid.Row="4" Margin="0,8,0,0">
                <TextBlock x:Name="step1" Text="&#x25CB; Extracting pak file"
                           Foreground="#6c7086" FontSize="12" Margin="0,2"/>
                <TextBlock x:Name="step2" Text="&#x25CB; Checking for combo tree"
                           Foreground="#6c7086" FontSize="12" Margin="0,2"/>
                <TextBlock x:Name="step3" Text="&#x25CB; Detecting stance"
                           Foreground="#6c7086" FontSize="12" Margin="0,2"/>
                <TextBlock x:Name="step4" Text="&#x25CB; Parsing modded animations"
                           Foreground="#6c7086" FontSize="12" Margin="0,2"/>
                <TextBlock x:Name="step5" Text="&#x25CB; Comparing with vanilla"
                           Foreground="#6c7086" FontSize="12" Margin="0,2"/>
                <TextBlock x:Name="step6" Text="&#x25CB; Finalizing"
                           Foreground="#6c7086" FontSize="12" Margin="0,2"/>
            </StackPanel>

            <!-- Current action -->
            <TextBlock x:Name="txtCurrentAction" Grid.Row="5" TextWrapping="Wrap"
                       FontSize="12" Foreground="#6c7086" Margin="0,8,0,0"/>

            <!-- Close button (hidden during loading) -->
            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right"
                        x:Name="loadingButtons" Visibility="Collapsed">
                <Button Content="Close" Style="{StaticResource AccentButton}"
                        Click="Close_Click" Padding="16,6"/>
            </StackPanel>
        </Grid>

        <!-- State 2: Complete -->
        <Grid x:Name="panelComplete" Visibility="Collapsed" Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" FontSize="15" FontWeight="Bold">
                <Run Text="&#x2713; " Foreground="#a6e3a1"/>
                <Run Text="Import complete!" Foreground="#cdd6f4"/>
            </TextBlock>

            <TextBlock x:Name="txtResult" Grid.Row="2" FontSize="13"
                       Foreground="#cdd6f4" TextWrapping="Wrap"/>

            <TextBlock x:Name="txtDetails" Grid.Row="3" FontSize="12"
                       Foreground="#6c7086" TextWrapping="Wrap" Margin="0,4,0,0"/>

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Style="{StaticResource AccentButton}"
                        Click="Close_Click" Padding="16,8" MinHeight="30"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
