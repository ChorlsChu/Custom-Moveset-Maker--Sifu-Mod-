<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Release ships as 1.4.1; the local Debug build reports 1.4 so it is not
         offered the older v1.4 release by the launch update check. -->
    <Version Condition="'$(Configuration)' == 'Release'">1.4.1</Version>
    <Version Condition="'$(Configuration)' != 'Release'">1.4</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tools\**" />
    <Content Remove="tools\**" />
    <EmbeddedResource Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="export_smoke" />
    <InternalsVisibleTo Include="import_smoke" />
    <InternalsVisibleTo Include="attack_hit_smoke" />
    <InternalsVisibleTo Include="update_notes_smoke" />
    <InternalsVisibleTo Include="version_history_smoke" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202608" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202608" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UAssetAPI">
      <HintPath>libs\UAssetAPI.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="viewer\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Template\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="settings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="README.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\ue4\UnrealPak\UnrealPak.exe" Condition="Exists('tools\ue4\UnrealPak\UnrealPak.exe')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\ue4\UnrealPak\UnrealPak-*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\ue4\UnrealPak\UnrealPak.modules" Condition="Exists('tools\ue4\UnrealPak\UnrealPak.modules')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="tools\ue4\UnrealPak\pakchunk0-WindowsNoEditor.sig" Condition="Exists('tools\ue4\UnrealPak\pakchunk0-WindowsNoEditor.sig')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Engine\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- UnrealPak writes 100+ MB of logs/crash configs here at runtime; never ship them. -->
    <Content Remove="Engine\Programs\UnrealPak\Saved\**\*" />
  </ItemGroup>

</Project>
