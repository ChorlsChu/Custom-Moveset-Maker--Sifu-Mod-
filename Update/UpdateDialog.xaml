<Window x:Class="SifuMovesetEditor.Update.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sifu Moveset Editor — Update"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1e1e2e"
        Foreground="#cdd6f4">

    <Window.Resources>
        <Style x:Key="DarkButton" TargetType="Button">
            <Setter Property="Background" Value="#313244"/>
            <Setter Property="Foreground" Value="#cdd6f4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45475a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#585b70"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource DarkButton}">
            <Setter Property="Background" Value="#89b4fa"/>
            <Setter Property="Foreground" Value="#1e1e2e"/>
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <Border DockPanel.Dock="Top" Background="#11111b" Padding="12,8" Margin="-16,-16,-16,12">
            <TextBlock Text="A new version is available" FontWeight="Bold"
                       Foreground="#89b4fa" FontSize="15"/>
        </Border>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnSkip" Content="Not now" Style="{StaticResource DarkButton}"
                    Click="Skip_Click" Padding="16,8" MinHeight="30" MinWidth="80"/>
            <Button x:Name="btnUpdate" Content="Update &amp; Restart" Style="{StaticResource AccentButton}"
                    Click="Update_Click" Padding="16,8" MinHeight="30" MinWidth="120"
                    IsDefault="True"/>
        </StackPanel>

        <StackPanel>
            <TextBlock x:Name="txtVersions" TextWrapping="Wrap" Foreground="#cdd6f4" FontSize="12" LineHeight="18"/>

            <Border x:Name="notesCard" Background="#181825" CornerRadius="4" Padding="10,8" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="What's new" FontWeight="SemiBold" Foreground="#a6e3a1" FontSize="12"/>
                    <ScrollViewer MaxHeight="240" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="txtNotes" TextWrapping="Wrap" Foreground="#a6adc8" FontSize="11"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <ProgressBar x:Name="downloadProgress" Height="8" Margin="0,12,0,0"
                         Foreground="#89b4fa" Background="#313244" BorderThickness="0"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="txtStatus" TextWrapping="Wrap" FontSize="11" Margin="0,8,0,0"
                       Foreground="#a6adc8" Visibility="Collapsed"/>
        </StackPanel>
    </DockPanel>
</Window>
